{
  "Routes": [
    {
      "UpstreamPathTemplate": "/internal/profiles",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/internal/profiles",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "profilemicroservice", "Port": 8080 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] },
      "RouteClaimsRequirement": { "role": "internal-service" }
    },
    {
      "UpstreamPathTemplate": "/api/profiles/me",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/profiles/me",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "profilemicroservice", "Port": 8080 } ],
      "Priority": 1,
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] },
      "AddHeadersToRequest": {
        "X-UserId": "Claims[sub] > value",
        "X-Role": "Claims[role] > value"
      }
    },
    {
      "UpstreamPathTemplate": "/api/profiles",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "DownstreamPathTemplate": "/api/profiles",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "profilemicroservice", "Port": 8080 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "UpstreamPathTemplate": "/api/profiles/{id}",
      "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/api/profiles/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "profilemicroservice", "Port": 8080 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "UpstreamPathTemplate": "/api/profiles/{id}/ban",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/api/profiles/{id}/ban",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "profilemicroservice", "Port": 8080 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] },
      "RouteClaimsRequirement": { "role": "internal-service" }
    },
    {
      "UpstreamPathTemplate": "/api/profiles/{id}/unban",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/api/profiles/{id}/unban",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "profilemicroservice", "Port": 8080 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] },
      "RouteClaimsRequirement": { "role": "internal-service" }
    },
    {
      "UpstreamPathTemplate": "/api/bans/{banId}",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/bans/{banId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "profilemicroservice", "Port": 8080 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] },
      "RouteClaimsRequirement": { "role": "internal-service" }
    },
    {
      "UpstreamPathTemplate": "/graphql",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/graphql",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "profilemicroservice", "Port": 8080 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    }
    
  ]
}