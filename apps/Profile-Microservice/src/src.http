@host = http://localhost:8000

### List all profiles
GET {{host}}/api/profiles
Accept: application/json

### Create a profile
POST {{host}}/api/profiles
Content-Type: application/json

{
  "displayName": "Yahya"
}

### Get one profile (replace the id with one from the response above)
GET {{host}}/api/profiles/REPLACE-WITH-ID
Accept: application/json

### Update display name
PUT {{host}}/api/profiles/REPLACE-WITH-ID
Content-Type: application/json

{
  "displayName": "Yahya K"
}

### Delete a profile
DELETE {{host}}/api/profiles/REPLACE-WITH-ID