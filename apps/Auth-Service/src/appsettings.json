{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "bizcord-auth",
    "Audience": "internal-api",
    "LifetimeMinutes": 5
  },
  "Clients": {
    "messageservice": { "Role": "internal-service" },
    "unprivileged": { "Role": "viewer" }
  }
}